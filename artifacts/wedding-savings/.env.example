# Copy this file to .env (same folder) and fill in real values.
# From Supabase: Project Settings -> API Keys.
# Both are safe to expose in frontend code by design — access control is
# enforced by Row Level Security on the database tables, not by keeping
# these secret.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
